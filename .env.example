# Milebook environment — copy to `.env` and fill in.
#
# The app reads `MILEBOOK_*` variables from the process environment. A `.env` file in the working directory is
# loaded at startup for keys that are not already set (see `src/index.ts` · `loadDotEnv`). Real environment
# variables always win, so a service manager can override a file without editing it.
#
# Required: AUTH_SECRET, MODEL_BASE_URL, MODEL_NAME. Everything else has a documented default.
# The full reference, with failure modes, is in docs/OPERATIONS.md.

# --- Required ---------------------------------------------------------------------------------------------------

# Signs every session cookie. At least 32 characters; the app refuses to start without it.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MILEBOOK_AUTH_SECRET=

# SQLite location. The directory is created at startup when missing.
MILEBOOK_DB=sqlite:data/milebook.sqlite

# OpenAI-compatible endpoint the coach gateway calls. Required; there is no built-in default.
MILEBOOK_MODEL_BASE_URL=
MILEBOOK_MODEL_API_KEY=
# Model id to request from that endpoint (e.g. the name the provider publishes).
MILEBOOK_MODEL_NAME=
# Model id advertised on /v1/models and in chat completion payloads.
MILEBOOK_MODEL_ID=milebook-coach

# --- Ports and topology -----------------------------------------------------------------------------------------

# Calendar web surface. Binds 0.0.0.0; put TLS in front of it.
MILEBOOK_WEB_PORT=8091
# Coach gateway. Binds 127.0.0.1 only; the browser reaches it through the web surface.
MILEBOOK_GATEWAY_PORT=8090
# How the web surface reaches the gateway (defaults to http://127.0.0.1:$MILEBOOK_GATEWAY_PORT).
MILEBOOK_GATEWAY_URL=

# --- Behaviour --------------------------------------------------------------------------------------------------

# Initial model call plus at most this many repair calls (minimum 1).
MILEBOOK_MAX_ATTEMPTS=2
# Deterministic coaching-state detection. false keeps manual/chat states working.
MILEBOOK_AUTO_STATES=true

# Identity used only for a gateway request with no x-milebook-user header.
MILEBOOK_DEFAULT_USER=system

# Shared web→gateway secret. Generated per start when unset; set it explicitly only if you run the two servers
# as separate processes.
MILEBOOK_INTERNAL_TOKEN=

# Adds `Secure` to session cookies and HSTS to responses. Enable whenever the site is served over HTTPS.
MILEBOOK_COOKIE_SECURE=false
