# Local data and secrets. Anchored to the repository root: a `data` directory elsewhere in the tree
# (e.g. tools/anatomy/data, the committed anatomy mapping) is source, not runtime state.
/data/
.env
.env.*
# The documented template is not a secret: it ships with the repository.
!.env.example
*.local
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.db

# Logs and editor noise
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
__pycache__/
*.pyc

# Local verification artifacts
tmp/
# Release artifact, regenerated per build
sbom.cdx.json
